+      if (m[2] === 'revise' && task.state !== 'done') return json(res, 409, { error: `task is ${task.state}` });
       const { feedback } = m[2] === 'revise' ? await body(req) : {};
       task.state = 'doing'; task.startedAt = Date.now(); save(list);
       try {
@@ -568,8 +585,8 @@ const server = http.createServer(async (req, res) => {
