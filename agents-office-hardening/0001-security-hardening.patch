 /* ---------- http ---------- */
 const json = (res, code, body) => { res.writeHead(code, { 'content-type': 'application/json' }); res.end(JSON.stringify(body)); };
-const body = req => new Promise((resolve, reject) => { let s = ''; req.on('data', d => { s += d; }); req.on('end', () => { try { resolve(s ? JSON.parse(s) : {}); } catch (e) { reject(e); } }); });
+const MAX_BODY = 1 << 20; // 1 MB: a task, a chat turn or a routine is never bigger
+const body = req => new Promise((resolve, reject) => { let s = ''; req.on('data', d => { s += d; if (s.length > MAX_BODY) { req.destroy(); reject(new Error('request too large')); } }); req.on('end', () => { try { resolve(s ? JSON.parse(s) : {}); } catch (e) { reject(e); } }); });
 
 await rebuildGraph();
 const discovering = mcp.discover().then(l => { console.log(`  connectors: ${l.filter(s => s.status === 'connected').length} connected of ${l.length} (claude mcp list)`); return l; });
 const agentsOut = () => { const setup = setupMap(); return AGENTS.map(a => ({ id: a.id, name: a.name, role: a.role, does: a.does, tools: a.tools, brief: a.brief || '', model: a.model || '', effort: a.effort || '', skills: skills.names(a), lessons: learn.count(BRAIN, a.id), department: a.department, lead: a.lead,
   interviewer: leadOf(a.department).id === a.id, setUp: setup[a.department] })); };
+// Only this machine's own page may drive the office. The Host check stops DNS rebinding; the Origin
+// check stops any other website from posting tasks, approvals or routines (the agents can send
+// email, post and pay); a JSON body forces a CORS preflight, which this server never answers.
+const LOCAL = new Set(['localhost', '127.0.0.1', '[::1]'].map(h => `${h}:${cfg.port}`));
+function refuse(req) {
+  if (!LOCAL.has(req.headers.host)) return 'host not allowed';
+  const o = req.headers.origin;
+  if (o && !(o.startsWith('http://') && LOCAL.has(o.slice(7)))) return 'origin not allowed';
+  if (req.method === 'POST' && +(req.headers['content-length'] || 0) > 0 && !/^application\/json\b/i.test(req.headers['content-type'] || '')) return 'send JSON';
+  return null;
+}
 const server = http.createServer(async (req, res) => {
