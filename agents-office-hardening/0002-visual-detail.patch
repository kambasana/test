   floor.position.y = 0;
   floor.castShadow = false;
   g.add(floor);
+  // V3.8: a dept-coloured hairline in the reveal, so each pod reads as its department from far out
+  if (chip) {
+    const rim = rbox(w - 0.36, d - 0.36, 0.1, mat(chip, { rough: 0.6 }), 0.8);
