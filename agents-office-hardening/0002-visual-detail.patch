+}
+
+/* ---------- V3.8 detail pass: grounding, rugs and one prop per department ---------- */
+let blobTex = null;
+function contactTex() { // a soft radial falloff, drawn once and shared by every contact shadow
+  if (blobTex) return blobTex;
+  const c = document.createElement('canvas'); c.width = c.height = 128;
+  const x = c.getContext('2d');
+  const gr = x.createRadialGradient(64, 64, 6, 64, 64, 62);
+  gr.addColorStop(0, 'rgba(21,20,20,0.55)'); gr.addColorStop(0.55, 'rgba(21,20,20,0.22)'); gr.addColorStop(1, 'rgba(21,20,20,0)');
+  x.fillStyle = gr; x.fillRect(0, 0, 128, 128);
+  blobTex = new THREE.CanvasTexture(c); blobTex.colorSpace = THREE.SRGBColorSpace;
+  return blobTex;
+}
+/** A soft ambient-occlusion pool on the floor: grounds desks, chairs and people where the key light can't. */
+export function makeContactShadow(w, d, opacity = 0.5) {
+  const m = new THREE.Mesh(new THREE.PlaneGeometry(w, d),
+    new THREE.MeshBasicMaterial({ map: contactTex(), transparent: true, opacity, depthWrite: false }));
+  m.rotation.x = -Math.PI / 2; m.position.y = 0.135; m.renderOrder = 1; m.userData.part = 'contact';
+  return m;
+}
+/** A rug under the desk cluster: the floor colour pulled slightly toward the dept chip. */
+export function makeRug(w, d, floorColor, chip) {
+  const c = new THREE.Color(floorColor).lerp(new THREE.Color(chip), 0.18);
+  const rug = rbox(w, d, 0.04, mat('#' + c.getHexString(), { rough: 1 }), 0.9);
+  rug.position.y = 0.12; rug.castShadow = false; rug.userData.part = 'rug';
+  return rug;
+}
+function boardTexture(draw, w = 512, h = 320) {
+  const c = document.createElement('canvas'); c.width = w; c.height = h;
+  draw(c.getContext('2d'), w, h);
+  const t = new THREE.CanvasTexture(c); t.colorSpace = THREE.SRGBColorSpace; t.anisotropy = 4;
+  return t;
+}
+function standingBoard(tex, w, h) { // a board on two thin legs, facing the camera once rotated
+  const g = new THREE.Group();
+  const frame = rbox(w + 0.2, 0.12, h + 0.2, '#E9E7DF', 0.06); frame.position.y = 1.6; g.add(frame);
+  const face = new THREE.Mesh(new THREE.PlaneGeometry(w, h), new THREE.MeshBasicMaterial({ map: tex }));
+  face.position.set(0, 1.7 + h / 2, 0.07); g.add(face);
+  for (const sx of [-1, 1]) {
+    const leg = rbox(0.12, 0.12, 1.65, '#8C8A83', 0.04); leg.position.set(sx * (w / 2 - 0.2), 0, -0.02); g.add(leg);
+  }
+  return g;
+}
+/** Sales: a whiteboard with the pipeline funnel sketched on it. */
+export function makeWhiteboard(chip) {
+  return standingBoard(boardTexture((x, W, H) => {
+    x.fillStyle = '#FFFFFF'; x.fillRect(0, 0, W, H);
+    x.fillStyle = '#151414'; x.font = '600 26px Georgia, serif'; x.fillText('Pipeline', 26, 44);
+    const rows = [[0.9, 'new'], [0.66, 'qualified'], [0.44, 'proposal'], [0.26, 'won']];
+    rows.forEach(([f, l], i) => {
+      const bw = (W - 200) * f, y = 76 + i * 56;
+      x.fillStyle = chip; x.globalAlpha = 0.85 - i * 0.12; x.fillRect((W - 120 - bw) / 2 + 10, y, bw, 38); x.globalAlpha = 1;
+      x.fillStyle = '#5A5A5A'; x.font = '18px Menlo, monospace'; x.fillText(l, W - 112, y + 25);
+    });
+  }), 3.6, 2.25);
+}
+/** Marketing: a mood board on an easel, swatches and pinned cards. */
+export function makeMoodBoard(chip) {
+  return standingBoard(boardTexture((x, W, H) => {
+    x.fillStyle = '#C9A57A'; x.fillRect(0, 0, W, H); // cork
+    const cards = [[24, 24, 150, 120, chip], [190, 30, 130, 170, '#FDFFF8'], [336, 22, 150, 110, '#151414'], [30, 160, 140, 130, '#FDFFF8'], [336, 150, 150, 140, chip]];
+    cards.forEach(([cx, cy, cw, ch, col], i) => {
+      x.fillStyle = 'rgba(0,0,0,.18)'; x.fillRect(cx + 4, cy + 5, cw, ch);
+      x.fillStyle = col; x.fillRect(cx, cy, cw, ch);
+      x.fillStyle = i % 2 ? '#E5484D' : '#2E86AB'; x.beginPath(); x.arc(cx + cw / 2, cy + 8, 6, 0, 7); x.fill();
+    });
+    x.fillStyle = '#151414'; x.font = 'italic 30px Georgia, serif'; x.fillText('Aa', 228, 140);
+  }), 3.4, 2.1);
+}
+/** Finance: two filing cabinets with drawer pulls. */
+export function makeFilingCabinets() {
+  const g = new THREE.Group();
+  for (const sx of [-0.75, 0.75]) {
+    const cab = rbox(1.4, 1.5, 3.1, '#D9D7CF', 0.1); cab.position.set(sx, 0, 0); g.add(cab);
+    for (let i = 0; i < 4; i++) {
+      const pull = rbox(0.5, 0.08, 0.1, '#8C8A83', 0.03); pull.position.set(sx, 0.45 + i * 0.72, 0.76); g.add(pull);
+    }
+  }
+  return g;
+}
+/** Emails: a pigeonhole mail sorter with letters in some slots. */
+export function makeMailSorter(chip) {
+  const g = new THREE.Group();
+  const box = rbox(3.2, 1.1, 2.6, '#E9E7DF', 0.08); g.add(box);
+  for (let r = 0; r < 3; r++) for (let c = 0; c < 4; c++) {
+    const slot = rbox(0.66, 0.2, 0.62, '#CFCBC0', 0.04); slot.position.set(-1.14 + c * 0.76, 0.22 + r * 0.8, 0.5); g.add(slot);
+    if ((r + c) % 3 !== 1) { const env = rbox(0.5, 0.08, 0.36, (r + c) % 2 ? '#FDFFF8' : chip, 0.02); env.position.set(-1.14 + c * 0.76, 0.4 + r * 0.8, 0.62); g.add(env); }
+  }
+  return g;
+}
+/** Delivery: a shelf of labelled project boxes. */
+export function makeShelf(chip) {
+  const g = new THREE.Group();
+  for (const sx of [-1.7, 1.7]) { const up = rbox(0.14, 1.2, 3.2, '#8C8A83', 0.04); up.position.set(sx, 0, 0); g.add(up); }
+  for (let i = 0; i < 3; i++) {
+    const board = rbox(3.5, 1.2, 0.1, '#DCC29A', 0.04); board.position.set(0, 0.3 + i * 1.05, 0); g.add(board);
+    for (let j = 0; j < 3; j++) {
+      const bx = rbox(0.9, 0.9, 0.7, j === 1 ? chip : '#F2EEE4', 0.06); bx.position.set(-1.1 + j * 1.1, 0.4 + i * 1.05, 0.05); g.add(bx);
+    }
+  }
   return g;
 }
 
