+    const pal = PALETTE[di % PALETTE.length];
+    DEPTS[d.key] = { name: d.name, short: d.name, chip: d.chip || pal.chip, ink: d.ink || pal.ink, floor: d.floor || pal.floor, prop: d.prop, boss: !!d.boss, about: d.about || '', teams: d.teams.map(t => t.name) };
+    DEPT_KEYS.push(d.key);
+    const shape = podShape(d.teams.map(t => t.people.length)); shapes.push(shape);
+    const people = [{ ...d.lead, lead: true, team: '' }, ...d.teams.flatMap(t => t.people.map(p => ({ ...p, lead: false, team: t.name })))];
+    people.forEach((p, i) => {
+      const h = [...p.id].reduce((s, c) => (s * 31 + c.charCodeAt(0)) >>> 0, 7);
+      const [c, r] = shape.place[i];
+      AGENTS.push({ id: p.id, name: p.name, dept: d.key, lead: p.lead, team: p.team, role: p.role || '', does: p.does || '',
+        grid: [c, r], gz: -shape.d / 2 + 7.6 + r * DESK_Z, cols: shape.cols, hair: HAIR[h % HAIR.length], skin: SKIN[(h >> 4) % SKIN.length] });
+    });
+    if (WORKLINES) WORKLINES[d.key] = (d.worklines && d.worklines.length ? d.worklines : d.teams.map(t => `${t.name.toLowerCase()}: on it`)).map(l => /^[▸✓•]/.test(l) ? l : '▸ ' + l);
+    if (APPROVAL_ASKS) APPROVAL_ASKS[d.key] = d.approvals && d.approvals.length ? d.approvals.slice() : [`Sign off ${d.name.toLowerCase()}'s latest deliverable`];
+  });
+  const pos = ringLayout(shapes);
+  org.departments.forEach((d, i) => { LAYOUT[d.key] = { pos: pos[i], w: shapes[i].w, d: shapes[i].d, ring: true }; });
+}
+
+export function applyOffice(T) {
+  if (!OFFICE) return;
+  const { DEPTS, DEPT_KEYS, AGENTS, LAYOUT, BILLBOARDS, APPROVAL_ASKS, APPROVAL_BY_AGENT, WORKLINES } = T;
+  if (OFFICE.org) applyOrg(OFFICE.org, T);
+  const off = new Set(OFFICE.off || []);
+  for (let i = AGENTS.length - 1; i >= 0; i--) if (off.has(AGENTS[i].dept)) AGENTS.splice(i, 1);
+  for (let i = DEPT_KEYS.length - 1; i >= 0; i--) if (off.has(DEPT_KEYS[i])) DEPT_KEYS.splice(i, 1);
+  for (const k of off) {
+    if (!DEPTS[k]) continue;
+    if (LAYOUT && LAYOUT[k]) DEPTS[k].offLayout = LAYOUT[k];
+    for (const X of [LAYOUT, BILLBOARDS, APPROVAL_ASKS, WORKLINES]) if (X) delete X[k];
+    DEPTS[k].off = true;
+  }
+  if (APPROVAL_BY_AGENT) for (const id of Object.keys(APPROVAL_BY_AGENT)) if (!AGENTS.some(a => a.id === id)) delete APPROVAL_BY_AGENT[id];
+}
+export const isOn = k => !(OFFICE && (OFFICE.off || []).includes(k));
