+function applyOrg(org, { DEPTS, DEPT_KEYS, AGENTS, LAYOUT, BILLBOARDS, APPROVAL_ASKS, APPROVAL_BY_AGENT, WORKLINES }) {
+  for (const k of Object.keys(DEPTS)) if (k !== 'brain') delete DEPTS[k];
+  for (const X of [LAYOUT, BILLBOARDS, APPROVAL_ASKS, WORKLINES]) if (X) for (const k of Object.keys(X)) if (k !== 'brain') delete X[k];
