+    const s = state, d = draft;
+    const changed = d.org !== s.org || s.slots.some(x => d.on[x.key] !== x.on);
+    const onCount = Object.values(d.on).filter(Boolean).length;
+    pane.innerHTML = `
+      <div class="dp-head"><div><div class="dp-k">${esc(s.wing || 'THIS OFFICE')}</div><h2>Departments</h2></div>
+        <button class="dp-x" type="button" aria-label="close">×</button></div>
+      <label class="dp-k" for="dpPack">WHOSE DEPARTMENTS</label>
+      <select id="dpPack" ${live ? '' : 'disabled'}>${s.orgs.map(p => `<option value="${esc(p.name)}"${p.name === d.org ? ' selected' : ''}>${esc(p.title)}</option>`).join('')}</select>
+      ${d.org !== s.org ? `<p class="dp-note">The floor is rebuilt from ${d.org ? `orgs/${esc(d.org)}.json` : "AJ's six departments"}. Notes, tasks and routines stay in this office's brain.</p>` : ''}
+      <div class="dp-k">ON THE FLOOR · ${onCount} OF ${s.slots.length}</div>
+      <ul class="dp-list">${s.slots.map(x => `
+        <li><span class="dot" style="background:${esc(x.chip || '#ccc')}"></span>
+          <span class="nm">${esc(x.name)}${x.boss ? ' <em>HANDS OUT WORK</em>' : ''}${x.seats || x.teams.length ? `<small>${[x.seats ? x.seats + ' people' : '', x.teams.length ? x.teams.map(t => t.charAt(0) + t.slice(1).toLowerCase()).join(' · ') : ''].filter(Boolean).join(' — ')}</small>` : ''}</span>
+          <span class="st">${d.on[x.key] ? 'On' : 'Off'}</span>
+          <button type="button" role="switch" aria-checked="${d.on[x.key]}" aria-label="${esc(x.name)}" data-k="${esc(x.key)}" ${live ? '' : 'disabled'}><i></i></button></li>`).join('')}
+      </ul>
+      <p class="dp-note">A department that is off has no desks on the floor, takes no tasks and runs nothing. Its notes stay in the brain.</p>
+      ${s.wings && s.wings.length ? `<div class="dp-k">OTHER WINGS ON THIS MACHINE</div><ul class="dp-wings">${s.wings.map(w => `<li><a href="${esc(w.url)}">${esc(w.name)}</a><span>own brain · own sandbox · nothing shared</span></li>`).join('')}</ul>` : ''}
+      <div class="dp-foot">${live
+        ? `<span class="dp-msg" role="status">${esc(msg || (changed ? 'Not saved yet.' : 'No changes.'))}</span>
+           <button class="dp-save" type="button" ${changed ? '' : 'disabled'}>SAVE</button>`
+        : `<span class="dp-msg">Start the office with <code>npm start</code> to change departments.</span>`}</div>`;
+    pane.querySelector('.dp-x').onclick = close;
+    const sel = pane.querySelector('#dpPack'); if (sel) sel.onchange = () => { draft.org = sel.value; msg = ''; render(); };
+    pane.querySelectorAll('[role=switch]').forEach(b => b.onclick = () => {
+      const k = b.dataset.k, next = !draft.on[k];
+      if (!next && Object.values(draft.on).filter(Boolean).length === 1) { msg = 'At least one department stays on.'; render(); return; }
+      draft.on[k] = next; msg = ''; render();
+    });
+    const save = pane.querySelector('.dp-save'); if (save) save.onclick = async () => {
+      save.disabled = true; msg = 'Saving…'; render();
+      try {
+        const r = await fetch('/api/departments', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ org: draft.org, off: draft.org === state.org ? state.slots.map(x => x.key).filter(k => !draft.on[k]) : [] }) });
+        const j = await r.json(); if (!r.ok) throw new Error(j.error || 'not saved');
+        msg = `Saved to ${j.file}. Restart the office to see the new floor.` + (j.overridden.length ? ` Note: ${j.overridden.join(' and ')} set when it started will still win.` : '');
+      } catch (e) { msg = 'Not saved: ' + e.message; }
+      render();
+    };
+  }
+  async function open() {
+    await load();
+    draft = { org: state.org, on: Object.fromEntries(state.slots.map(x => [x.key, x.on])) }; msg = '';
+    render(); document.body.classList.add('dpOpen'); pane.querySelector('.dp-x').focus();
+  }
+  function close() { document.body.classList.remove('dpOpen'); btn.focus(); }
+  btn.onclick = () => document.body.classList.contains('dpOpen') ? close() : open();
+  document.addEventListener('keydown', e => { if (e.key === 'Escape' && document.body.classList.contains('dpOpen')) close(); });
+}
