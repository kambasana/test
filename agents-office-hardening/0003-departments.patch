+++ b/office.mjs
@@ -0,0 +1,122 @@
+// Agents Office — builds globalThis.OFFICE before anything imports src/data.js (see src/office.js).
+// Import this FIRST (serve.mjs and roster.mjs do).
+//
+// Settings keys (office.config.json / office.config.local.json, or the file AO_CONFIG names):
+//   org          the name of a file in orgs/ — your departments, sub-teams and people. Without it
+//                the office is AJ's agency, unchanged.
+//   departments  { "<key>": { "on": false } } — take a department off the floor
+//   wing         this office's name in the wing switcher, e.g. "MAIN OFFICE"
+//   wings        [{ "name": "R&D", "url": "http://localhost:4521" }] — other offices on this machine
+// Environment: AO_ORG, AO_OFF (comma-separated keys), AO_WING override the files.
+//
+// orgs/<name>.json:
+//   { "title": "…",
+//     "departments": [
+//       { "key": "military", "name": "MILITARY", "about": "what work this department owns (the Boss reads it)",
+//         "boss": false, "chip": "#rrggbb", "prop": "rack",
+//         "lead":  { "id": "mil-lead", "name": "MILITARY LEAD", "role": "…", "does": "…", "tasks": […], "chips": […] },
+//         "teams": [ { "name": "SOFTWARE", "people": [ { "id": "…", "name": "…", "role": "…", "does": "…", "tasks": […] } ] } ],
+//         "worklines": […], "approvals": […], "kpis": [{ "label": "…", "val": 0 }] } ] }
+//   One department may be the boss ("boss": true): work given to it is passed to the department
+//   that owns it. Ids are optional (made from the name) but must be unique across the org.
+import fs from 'node:fs';
+import path from 'node:path';
+import { ROOT, loadConfig } from './config.mjs';
+
+const AJ = ['emails', 'sales', 'marketing', 'ops', 'fin', 'delivery'];
+const HEX = /^#[0-9a-f]{6}$/i, KEY = /^[a-z][a-z0-9-]{0,23}$/;
+const LIMITS = { departments: 12, perDept: 30, total: 150 };
+const slug = s => String(s).toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '').slice(0, 30);
+const str = (v, n) => String(v ?? '').trim().slice(0, n);
+const list = (v, n, m) => (Array.isArray(v) ? v : []).map(x => str(x, m)).filter(Boolean).slice(0, n);
+
+export function listOrgs() {
+  try { return fs.readdirSync(path.join(ROOT, 'orgs')).filter(f => f.endsWith('.json')).map(f => f.slice(0, -5)); } catch { return []; }
+}
+
+/** read and check an org file; returns { org, problems } — problems are sentences, never thrown */
+export function readOrg(name) {
+  const problems = [];
+  if (!name) return { org: null, problems };
+  if (!/^[a-z0-9-]{1,40}$/.test(name)) return { org: null, problems: [`org "${name}": names are lower-case letters, digits and dashes — using AJ's agency`] };
+  let doc; try { doc = JSON.parse(fs.readFileSync(path.join(ROOT, 'orgs', name + '.json'), 'utf8')); }
+  catch (e) { return { org: null, problems: [`org "${name}": ${e.code === 'ENOENT' ? 'no such file in orgs/' : 'not valid JSON (' + e.message.split('\n')[0] + ')'} — using AJ's agency`] }; }
+  const ids = new Set(), keys = new Set(); let total = 0, bosses = 0;
+  const person = (p, dk, where) => {
+    if (!p || !str(p.name, 32)) { problems.push(`${where}: a person has no name — left out`); return null; }
+    let id = slug(p.id || `${dk}-${p.name}`); if (!id) id = `${dk}-${ids.size}`;
+    if (ids.has(id)) { const id2 = `${id}-${ids.size}`; problems.push(`${where}: id "${id}" is used twice — the second is "${id2}"`); id = id2; }
+    ids.add(id);
+    return { id, name: str(p.name, 32).toUpperCase(), role: str(p.role, 80), does: str(p.does, 400), tasks: list(p.tasks, 6, 120), chips: list(p.chips, 3, 60), greeting: p.greeting ? str(p.greeting, 300) : undefined };
+  };
+  const departments = [];
+  for (const d of Array.isArray(doc.departments) ? doc.departments : []) {
+    if (departments.length >= LIMITS.departments) { problems.push(`more than ${LIMITS.departments} departments — the rest are left out`); break; }
+    const key = slug(d?.key || d?.name || '').replace(/^[^a-z]+/, '');
+    if (!key || !KEY.test(key) || key === 'brain' || keys.has(key)) { problems.push(`department "${d?.name || d?.key || '?'}": needs a unique key (letters, digits, dashes; not "brain") — left out`); continue; }
+    keys.add(key);
+    const out = { key, name: str(d.name || key, 24).toUpperCase(), about: str(d.about, 300), boss: d.boss === true && bosses++ === 0, prop: d.prop,
+      worklines: list(d.worklines, 6, 80), approvals: list(d.approvals, 4, 140), kpis: (Array.isArray(d.kpis) ? d.kpis : []).slice(0, 3).map(k => ({ label: str(k.label, 28).toUpperCase(), val: Number.isFinite(k.val) ? k.val : 0 })) };
+    if (d.boss === true && !out.boss) problems.push(`${out.name}: only one department can be the boss — this one isn't`);
+    for (const c of ['chip', 'ink', 'floor']) if (d[c] !== undefined) { if (HEX.test(d[c])) out[c] = d[c]; else problems.push(`${out.name}.${c} must be a #rrggbb colour — ignored`); }
+    out.lead = person(d.lead || { name: `${out.name} LEAD`, role: `Head of ${out.name.toLowerCase()}` }, key, out.name);
+    out.teams = []; let n = 1;
+    for (const t of Array.isArray(d.teams) ? d.teams : []) {
+      const people = [];
+      for (const p of Array.isArray(t?.people) ? t.people : []) {
+        if (n >= LIMITS.perDept || total >= LIMITS.total) { problems.push(`${out.name}: too many people (max ${LIMITS.perDept} a department, ${LIMITS.total} in all) — the rest are left out`); break; }
+        const q = person(p, key, out.name); if (q) { people.push(q); n++; }
+      }
+      if (people.length) out.teams.push({ name: str(t.name || 'TEAM', 24).toUpperCase(), people });
+    }
+    total += n; departments.push(out);
+  }
+  if (!departments.length) return { org: null, problems: [...problems, `org "${name}": no departments — using AJ's agency`] };
+  return { org: { name, title: str(doc.title || name, 60), departments }, problems };
+}
+
+/** the INDUSTRY PROFILE shape (src/profile.js) the dashboard's demo content already understands */
+function toProfile(org, company) {
+  const pods = {}, agents = {}, worklines = {}, kpis = {}, approvals = {};
+  for (const d of org.departments) {
+    pods[d.key] = d.name;
+    const dn = d.name.toLowerCase();
+    const fallback = (p, team) => p === d.lead
+      ? (d.boss ? ['Routing the latest requests', 'Checking what each department delivered', 'Setting this week\'s priorities'] : [`Splitting the latest ${dn} job across the sub-teams`, `Reviewing what the sub-teams delivered`, `Planning the next ${dn} milestone`])
+      : [`Working on the latest ${team.toLowerCase()} job`, `Handing a finished piece back to the ${dn} lead`];
+    const add = (p, team) => { agents[p.id] = { name: p.name, role: p.role, does: p.does, tasks: p.tasks.length ? p.tasks : fallback(p, team), chips: p.chips, greeting: p.greeting, tools: [] }; };
+    add(d.lead, ''); for (const t of d.teams) for (const p of t.people) add(p, t.name);
+    worklines[d.key] = d.worklines; approvals[d.key] = d.approvals;
+    kpis[d.key] = d.kpis.length ? d.kpis : [{ label: 'SUB-TEAMS', val: d.teams.length }];
+  }
+  return { slug: org.name, industry: org.title, company, pods, agents, worklines, kpis, approvals, documents: {}, segments: [], world: {}, strip: [], logos: {} };
+}
+
+let FULL = null; // the whole org (tasks, chips) — only the page profile needs it
+/** the page's window.PROFILE for this org */
+export function pageProfile(office, AGENTS, company) { return FULL ? toProfile(FULL, company) : null; }
+
+/** the org as the page and src/data.js need it: structure and names, no task pools */
+const slim = org => ({ name: org.name, title: org.title, departments: org.departments.map(d => ({
+  key: d.key, name: d.name, about: d.about, boss: d.boss, prop: d.prop, chip: d.chip, ink: d.ink, floor: d.floor, worklines: d.worklines, approvals: d.approvals,
+  lead: { id: d.lead.id, name: d.lead.name, role: d.lead.role, does: d.lead.does },
+  teams: d.teams.map(t => ({ name: t.name, people: t.people.map(({ id, name, role, does }) => ({ id, name, role, does })) })) })) });
+
+export function buildOffice(cfg = loadConfig()) {
+  const problems = [];
+  const name = process.env.AO_ORG !== undefined ? process.env.AO_ORG : (cfg.org || '');
+  const { org, problems: op } = readOrg(name); problems.push(...op);
+  const keys = org ? org.departments.map(d => d.key) : AJ;
+  const deps = cfg.departments || {};
+  let off = keys.filter(k => deps[k] && deps[k].on === false);
+  if (process.env.AO_OFF !== undefined) off = String(process.env.AO_OFF).split(',').map(s => s.trim()).filter(k => keys.includes(k));
+  if (off.length >= keys.length) { problems.push('every department is off — turning the first one back on'); off = off.filter(k => k !== keys[0]); }
+  const wings = (Array.isArray(cfg.wings) ? cfg.wings : []).filter(w => w && w.name && /^https?:\/\/(localhost|127\.0\.0\.1)(:\d+)?\/?$/.test(String(w.url || '')))
+    .map(w => ({ name: String(w.name).slice(0, 24), url: String(w.url) }));
+  if ((cfg.wings || []).length !== wings.length) problems.push('wings: only links to http://localhost:<port> or 127.0.0.1 are kept — a wing is another office on this machine');
+  FULL = org;
+  return { org: org ? slim(org) : null, off, wing: String(process.env.AO_WING || cfg.wing || '').slice(0, 24), wings, problems };
+}
+
+// set it now, before src/data.js is evaluated by whoever imported us
+globalThis.OFFICE = buildOffice();
