+  let R = Math.max(...half) + 18;
+  if (N > 1) for (let i = 0; i < N; i++) { const j = (i + 1) % N; R = Math.max(R, (half[i] + half[j] + 6) / (2 * Math.sin(Math.PI / N))); }
