new file mode 100644
index 0000000..f86a015
--- /dev/null
+++ b/office.mjs
@@ -0,0 +1,87 @@
+// Agents Office — builds globalThis.OFFICE before anything imports src/data.js (see src/office.js).
+// Import this FIRST (serve.mjs, roster.mjs, check.mjs do).
+//
+// office.config.json / office.config.local.json keys:
+//   pack         "agency" (AJ's six departments, the default) or the name of a file in packs/
+//   departments  { "<slot>": { "on": false } } — take a department off the floor
+//   wing         this office's name in the wing switcher, e.g. "R&D"
+//   wings        [{ "name": "Main office", "url": "http://localhost:4520" }] — other offices to link to
+// Environment: AO_PACK, AO_WING, AO_OFF (comma-separated slots) override the files.
+import fs from 'node:fs';
+import path from 'node:path';
+import { ROOT, loadConfig } from './config.mjs';
+
+const SLOTS = ['emails', 'sales', 'marketing', 'ops', 'fin', 'delivery'];
+const SEATS = { emails: 5, sales: 6, marketing: 7, ops: 6, fin: 4, delivery: 7 }; // the floor's fixed desks per slot
+const HEX = /^#[0-9a-f]{6}$/i;
+
+export function listPacks() {
+  try { return fs.readdirSync(path.join(ROOT, 'packs')).filter(f => f.endsWith('.json')).map(f => f.slice(0, -5)); } catch { return []; }
+}
+
+/** read and check a pack; returns { pack, problems } — problems are sentences, never thrown */
+export function readPack(name) {
+  const problems = [];
+  if (!name || name === 'agency') return { pack: null, problems };
+  if (!/^[a-z0-9-]{1,40}$/.test(name)) return { pack: null, problems: [`pack "${name}": names are lower-case letters, digits and dashes — using agency`] };
+  let doc; try { doc = JSON.parse(fs.readFileSync(path.join(ROOT, 'packs', name + '.json'), 'utf8')); }
+  catch (e) { return { pack: null, problems: [`pack "${name}": ${e.code === 'ENOENT' ? 'no such file in packs/' : 'not valid JSON'} — using agency`] }; }
+  const pack = { name, title: String(doc.title || name).slice(0, 60), about: String(doc.about || '').slice(0, 400), slots: {}, world: doc.world || {}, segments: Array.isArray(doc.segments) ? doc.segments.slice(0, 12) : [] };
+  for (const k of SLOTS) {
+    const s = doc.slots && doc.slots[k]; if (!s) continue;
+    const seats = Array.isArray(s.seats) ? s.seats.filter(p => p && p.name) : [];
+    if (seats.length > SEATS[k]) problems.push(`pack "${name}": ${k} has ${seats.length} seats, the floor has ${SEATS[k]} — the rest are left out`);
+    const out = { name: String(s.name || k).toUpperCase().slice(0, 24), prop: s.prop, seats: seats.slice(0, SEATS[k]).map(p => ({
+      name: String(p.name).toUpperCase().slice(0, 32), role: String(p.role || '').slice(0, 80), does: String(p.does || '').slice(0, 400),
+      tasks: (p.tasks || []).map(String).slice(0, 6), chips: (p.chips || []).map(String).slice(0, 3), greeting: p.greeting ? String(p.greeting).slice(0, 300) : undefined })),
+      worklines: (s.worklines || []).map(String).slice(0, 6), kpis: (s.kpis || []).slice(0, 3), approvals: (s.approvals || []).map(String).slice(0, 4), document: s.document || null };
+    for (const c of ['chip', 'ink', 'floor']) if (s[c] !== undefined) { if (HEX.test(s[c])) out[c] = s[c]; else problems.push(`pack "${name}": ${k}.${c} must be a #rrggbb colour — ignored`); }
+    if (!out.seats.length) problems.push(`pack "${name}": ${k} has no seats — the slot is left empty`);
+    pack.slots[k] = out;
+  }
+  return { pack, problems };
+}
+
+/** the INDUSTRY PROFILE shape (src/profile.js) the dashboard's demo content already understands */
+function toProfile(pack, office, company, seatIds) {
+  const pods = {}, agents = {}, worklines = {}, kpis = {}, approvals = {}, documents = {};
+  for (const k of SLOTS) {
+    const s = pack.slots[k]; if (!s || office.off.includes(k)) continue;
+    pods[k] = s.name;
+    s.seats.forEach((p, i) => { const id = seatIds[k][i]; if (id) agents[id] = { name: p.name, role: p.role, does: p.does, tasks: p.tasks.length ? p.tasks : [p.does || 'Working through the queue'], chips: p.chips, greeting: p.greeting, tools: [] }; });
+    if (s.worklines.length) worklines[k] = s.worklines;
+    if (s.kpis.length) kpis[k] = s.kpis;
+    if (s.approvals.length) approvals[k] = s.approvals;
+    if (s.document) documents[k] = s.document;
+  }
+  return { slug: pack.name, industry: pack.title, company, pods, agents, worklines, kpis, approvals, documents, segments: pack.segments, world: pack.world, strip: [], logos: {} };
+}
+
+let FULL = null; // the whole pack (tasks, chips, documents) — only the server needs it, to write the page's profile
+/** the page's window.PROFILE for this pack, with seat ids taken from the (already filtered) AGENTS */
+export function pageProfile(office, AGENTS, company) {
+  if (!FULL) return null;
+  const seatIds = Object.fromEntries(SLOTS.map(k => [k, AGENTS.filter(a => a.dept === k).map(a => a.id)]));
+  return toProfile(FULL, office, company, seatIds);
+}
+
+export function buildOffice(cfg = loadConfig()) {
+  const problems = [];
+  const name = process.env.AO_PACK || cfg.pack || 'agency';
+  const { pack, problems: pp } = readPack(name); problems.push(...pp);
+  const deps = cfg.departments || {};
+  let off = SLOTS.filter(k => deps[k] && deps[k].on === false);
+  if (process.env.AO_OFF !== undefined) off = String(process.env.AO_OFF).split(',').map(s => s.trim()).filter(k => SLOTS.includes(k));
+  if (pack) for (const k of SLOTS) if (!pack.slots[k] || !pack.slots[k].seats.length) if (!off.includes(k)) off.push(k);
+  if (off.length === SLOTS.length) { problems.push('every department is off — turning the first one back on'); off = off.slice(1); }
+  const wings = (Array.isArray(cfg.wings) ? cfg.wings : []).filter(w => w && w.name && /^https?:\/\/(localhost|127\.0\.0\.1)(:\d+)?\/?$/.test(String(w.url || '')))
+    .map(w => ({ name: String(w.name).slice(0, 24), url: String(w.url) }));
+  if ((cfg.wings || []).length !== wings.length) problems.push('wings: only links to http://localhost:<port> or 127.0.0.1 are kept — a wing is another office on this machine');
+  const office = { pack: pack ? { name: pack.name, title: pack.title, slots: Object.fromEntries(Object.entries(pack.slots).map(([k, s]) => [k, { name: s.name, chip: s.chip, ink: s.ink, floor: s.floor, prop: s.prop, seats: s.seats.map(({ name, role, does }) => ({ name, role, does })) }])) } : null,
+    off, wing: String(process.env.AO_WING || cfg.wing || '').slice(0, 24), wings, problems };
+  FULL = pack;
+  return office;
+}
+
+// set it now, before src/data.js is evaluated by whoever imported us
+globalThis.OFFICE = buildOffice();
