--- /dev/null
+++ b/src/office.js
@@ -0,0 +1,37 @@
+// Agents Office — departments you choose (packs, on/off, wings).
+// The floor has six fixed slots around the brain (emails · sales · marketing · ops · fin · delivery);
+// their geometry is hand-tuned and stays. What sits in each slot is yours:
+//   · a PACK (packs/<name>.json) renames the slot, recolours it and gives its seats new names, roles,
+//     tasks and screen lines. Seats map by order onto the slot's existing seat ids, lead first; a pack
+//     with fewer seats leaves the rest out.
+//   · departments.<slot>.on = false takes a slot off the floor: no pod, no agents, no tasks, no runs.
+//   · a WING is another office (its own process, brain folder, data folder and sandbox); the top bar
+//     links to it, nothing else is shared. See office.mjs.
+// The server builds globalThis.OFFICE (office.mjs) and writes it into the page; without it (the
+// double-click build) everything below is a no-op and the office is AJ's agency, unchanged.
+export const OFFICE = (typeof globalThis !== 'undefined' && globalThis.OFFICE) || null;
+export const SLOTS = ['emails', 'sales', 'marketing', 'ops', 'fin', 'delivery'];
+
+export function applyOffice({ DEPTS, DEPT_KEYS, AGENTS, LAYOUT, BILLBOARDS, APPROVAL_ASKS, APPROVAL_BY_AGENT, WORKLINES }) {
+  if (!OFFICE) return;
+  const pack = OFFICE.pack || null;
+  if (pack) for (const k of SLOTS) {
+    const s = pack.slots && pack.slots[k]; if (!s) continue;
+    if (s.name) { DEPTS[k].name = s.name; DEPTS[k].short = s.name; }
+    for (const c of ['chip', 'ink', 'floor']) if (s[c]) DEPTS[k][c] = s[c];
+    if (s.prop) DEPTS[k].prop = s.prop;
+    const seats = AGENTS.filter(a => a.dept === k);
+    seats.forEach((a, i) => {
+      const p = (s.seats || [])[i];
+      if (!p) { a._drop = true; return; }
+      a.name = String(p.name).toUpperCase().slice(0, 32); a.role = p.role || ''; a.does = p.does || '';
+    });
+  }
+  const off = new Set(OFFICE.off || []);
+  for (const a of AGENTS) if (off.has(a.dept)) a._drop = true;
+  for (let i = AGENTS.length - 1; i >= 0; i--) if (AGENTS[i]._drop) AGENTS.splice(i, 1);
+  for (let i = DEPT_KEYS.length - 1; i >= 0; i--) if (off.has(DEPT_KEYS[i])) DEPT_KEYS.splice(i, 1);
+  for (const k of off) { if (LAYOUT && LAYOUT[k]) DEPTS[k].offLayout = LAYOUT[k]; if (LAYOUT) delete LAYOUT[k]; if (BILLBOARDS) delete BILLBOARDS[k]; if (APPROVAL_ASKS) delete APPROVAL_ASKS[k]; if (WORKLINES) delete WORKLINES[k]; DEPTS[k].off = true; }
+  if (APPROVAL_BY_AGENT) for (const id of Object.keys(APPROVAL_BY_AGENT)) if (!AGENTS.some(a => a.id === id)) delete APPROVAL_BY_AGENT[id];
+}
+export const isOn = k => !(OFFICE && (OFFICE.off || []).includes(k));
