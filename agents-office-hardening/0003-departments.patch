+  const pane = document.createElement('div'); pane.id = 'dpPane'; pane.setAttribute('role', 'dialog'); pane.setAttribute('aria-label', 'Departments');
+  document.body.appendChild(pane);
+  let state = null, draft = null, msg = '';
+
+  const local = () => ({
+    org: (OFFICE && OFFICE.org && OFFICE.org.name) || '',
+    orgs: [{ name: (OFFICE && OFFICE.org && OFFICE.org.name) || '', title: (OFFICE && OFFICE.org && OFFICE.org.title) || "AJ's agency (the original six)" }],
+    slots: Object.keys(DEPTS).filter(k => k !== 'brain').map(k => ({ key: k, name: DEPTS[k].name, chip: DEPTS[k].chip, on: !DEPTS[k].off, boss: !!DEPTS[k].boss, teams: DEPTS[k].teams || [], seats: 0 })),
+    wing: (OFFICE && OFFICE.wing) || '', wings,
