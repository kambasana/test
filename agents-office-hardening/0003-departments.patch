+// Agents Office — YOUR departments (Oct 2026).
+// Without an org file the office is AJ's agency: six fixed pods, 35 desks, unchanged.
+// With one (orgs/<name>.json, chosen by `"org"` in the settings), the office is built ONLY from it:
+//   · any number of departments, each owning a domain of work (e.g. MILITARY does the military
+//     coding, documents and analysis), each made of sub-teams, each sub-team of people;
+//   · one department can be the BOSS: give it work and it decides which department does it;
+//   · a department grows by adding sub-teams and people, and its pod grows to fit;
+//   · departments.<key>.on = false takes one off the floor (no desks, no tasks, no runs);
+//   · a WING is a separate office (own process, brain, data, sandbox), linked from the top bar.
+// The server builds globalThis.OFFICE (office.mjs) and writes it into the page; without it (the
+// double-click build) everything below is a no-op.
+export const OFFICE = (typeof globalThis !== 'undefined' && globalThis.OFFICE) || null;
+export const SLOTS = ['emails', 'sales', 'marketing', 'ops', 'fin', 'delivery']; // AJ's six, when there is no org
+
+// colours for departments that don't name their own: AJ's chips, then a few more in the same family
+export const PALETTE = [
+  { chip: '#5ADEB7', ink: '#1E9070', floor: '#E9F6EF' }, { chip: '#EADC8F', ink: '#A08A1E', floor: '#F6F1DA' },
+  { chip: '#E69393', ink: '#C46060', floor: '#FAE9E7' }, { chip: '#BFA2E3', ink: '#7449A9', floor: '#F2ECFA' },
+  { chip: '#98A5EF', ink: '#5B66CE', floor: '#EAEDFA' }, { chip: '#8FD3F4', ink: '#2E86AB', floor: '#E6F4FB' },
+  { chip: '#F2B33D', ink: '#9A6A06', floor: '#FBF1DD' }, { chip: '#9FCF8A', ink: '#4E8A36', floor: '#EEF6E8' },
+];
+const HAIR = ['#2b2b2b', '#3b2b1d', '#111111', '#7a3b12', '#4a2a10', '#5a2d0c', '#1c1c2e', '#26140a', '#8a4a1f', '#552200'];
+const SKIN = ['#E8B98E', '#F0C9A0', '#C68B59', '#F5D5B0', '#D89F70', '#E0A878', '#B07850', '#9C6B43', '#D9A97E', '#8A5A32'];
+const DESK_X = 8.6, DESK_Z = 6.4;
+
+/** pod geometry for a department whose sub-teams have these sizes: the lead alone on the back
+ *  row, then each sub-team on its own row(s). { cols, rows, w, d, place: [[col,row]…] lead first } */
+export function podShape(teamSizes) {
+  const n = teamSizes.reduce((s, x) => s + x, 0) + 1;
+  const cols = n <= 9 ? 2 : n <= 16 ? 3 : 4;
+  const place = [[(cols - 1) / 2, 0]]; let row = 1;
