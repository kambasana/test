+// DEPARTMENTS panel (Oct 2026): which pack fills the floor, which departments are on, and the
+// other wings (offices) on this machine. Changes are written to office.config.local.json by the
+// server and take effect when the office restarts: the roster, routes and runs are all read once.
+import { DEPTS } from './data.js';
+import { OFFICE, SLOTS } from './office.js';
+
+const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
+
+export function initDepartments({ live }) {
+  const bar = document.getElementById('topbar'), cal = document.getElementById('topCal');
+  if (!bar || !cal) return;
+  // the wing switcher: this office, then the others; a wing is its own office, so it's just a link
+  const wings = (OFFICE && OFFICE.wings) || [];
+  if (wings.length || (OFFICE && OFFICE.wing)) {
+    const w = document.createElement('nav'); w.id = 'topWings'; w.setAttribute('aria-label', 'wings');
+    w.innerHTML = `<span class="w on" aria-current="page">${esc((OFFICE && OFFICE.wing) || 'THIS OFFICE')}</span>` +
+      wings.map(x => `<a class="w" href="${esc(x.url)}" title="another office on this machine: its own brain, tasks and sandbox">${esc(x.name)}</a>`).join('');
+    bar.insertBefore(w, document.getElementById('topmodels'));
+  }
+  const btn = document.createElement('button'); btn.id = 'topDepts'; btn.type = 'button';
+  btn.title = 'which departments are on, and what fills the floor'; btn.textContent = '▦ DEPARTMENTS';
+  cal.before(btn);
+
+  const pane = document.createElement('div'); pane.id = 'dpPane'; pane.setAttribute('role', 'dialog'); pane.setAttribute('aria-label', 'Departments');
+  document.body.appendChild(pane);
+  let state = null, draft = null, msg = '';
+
+  const local = () => ({
+    pack: (OFFICE && OFFICE.pack && OFFICE.pack.name) || 'agency',
+    packs: [{ name: 'agency', title: 'Agency (the original six)' }],
+    slots: SLOTS.map(k => ({ key: k, name: (DEPTS[k] && DEPTS[k].name) || k, chip: DEPTS[k] && DEPTS[k].chip, on: !(DEPTS[k] && DEPTS[k].off), seats: 0 })),
+    wing: (OFFICE && OFFICE.wing) || '', wings,
+  });
+  async function load() {
+    if (!live) { state = local(); return; }
+    try { const r = await fetch('/api/departments'); state = await r.json(); } catch { state = local(); }
+  }
+  function render() {
+    const s = state, d = draft;
+    const changed = d.pack !== s.pack || s.slots.some(x => d.on[x.key] !== x.on);
